# PROJ-1 — Local user accounts & login (100% local, no cloud)
#
# Everything runs on the company's Mac mini. There are NO external services
# and NO secrets to obtain from any provider. These variables are optional and
# only override sensible local defaults.

# Path to the local SQLite database file (default: ./data/app.db).
# DATABASE_PATH=/Users/admin/kmu-assistant/data/app.db

# Session lifetime in days (default: 7).
# SESSION_LIFETIME_DAYS=7

# --- Not used in this 100%-local version ---
# The cloud Supabase client is intentionally unused (see PROJ-1 tech design).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
